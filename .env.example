POSTGRES_DB=iddrv
POSTGRES_USER=iddrv_user
# Required: generate a site-specific password, then URL-encode it in both URLs.
POSTGRES_PASSWORD=
DATABASE_URL=
DOCKER_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
RAW_STORE_PATH=./data/raw
SAMPLES_PATH=./data/samples
# Required: generate at least 32 random characters. The pilot refuses an empty value.
SESSION_SECRET=
# Keep false only for the documented HTTP pilot; set true behind HTTPS.
SESSION_COOKIE_SECURE=false
# HTTP binds to localhost only; use an HTTPS reverse proxy for LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
APP_ENV=pilot
# Local development only: pair both flags to enter the read-only platform without a login page.
ALLOW_ANONYMOUS_READS=false
# Optional shared secret for Prometheus scrapes of GET /metrics.
# Prefer X-Metrics-Token or Authorization: Bearer. Leave empty to require an admin session in pilot.
METRICS_TOKEN=
# Force-open /metrics only for local debugging. Pilot default is false.
METRICS_PUBLIC=false
VITE_SKIP_AUTH=false
VITE_ENABLE_3D=false
# Tests only. Set exactly as documented before allowing destructive E2E cleanup.
E2E_DESTRUCTIVE_CLEANUP_CONFIRMATION=
