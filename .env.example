# PostgreSQL owner used by the local Compose database.
POSTGRES_DB=iddrv
POSTGRES_USER=iddrv_user
# Required: use a unique password and URL-encode it in the owner URLs below.
POSTGRES_PASSWORD=
# Host URL for scripts run from this checkout (PostgreSQL is loopback-only).
DATABASE_URL=postgresql://iddrv_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/iddrv
# URL consumed by the migration service; the database hostname is `timescaledb`.
DOCKER_DATABASE_URL=postgresql://iddrv_user:URL_ENCODED_PASSWORD@timescaledb:5432/iddrv
OWNER_DATABASE_URL=postgresql://iddrv_user:URL_ENCODED_PASSWORD@timescaledb:5432/iddrv
# Required as two distinct roles in pilot/production. Both are created by
# db/runtime_roles.py; development may leave them empty and use the owner URL.
API_DATABASE_URL=postgresql://iddrv_api:URL_ENCODED_API_PASSWORD@timescaledb:5432/iddrv
WORKER_DATABASE_URL=postgresql://iddrv_worker:URL_ENCODED_WORKER_PASSWORD@timescaledb:5432/iddrv
REDIS_URL=redis://localhost:6379/0
# Published artifacts are trained and served with Python 3.13.x,
# scikit-learn 1.7.2 and joblib 1.5.2.
PROCESS_DRIFT_MODEL_PATH=models/process_drift_hdt_v1.joblib
SCRAP_RISK_MODEL_PATH=models/rebut_risk_v1.joblib
RAW_STORE_PATH=./data/raw
SAMPLES_PATH=./data/samples
# Required: generate at least 32 random characters. The pilot refuses an empty value.
SESSION_SECRET=
# Keep false only for the documented HTTP pilot; set true behind HTTPS.
SESSION_COOKIE_SECURE=false
# HTTP binds to localhost only; use an HTTPS reverse proxy for LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
APP_ENV=pilot
# Local development only: pair both flags to enter the read-only platform without a login page.
ALLOW_ANONYMOUS_READS=false
# Optional shared secret for Prometheus scrapes of GET /metrics.
# Prefer X-Metrics-Token or Authorization: Bearer. Leave empty to require an admin session in pilot.
METRICS_TOKEN=
# Force-open /metrics only for local debugging. Pilot default is false.
METRICS_PUBLIC=false
# Only list proxy addresses that are controlled by this deployment. The local
# Compose web gateway is fixed at 172.30.0.10; pilot uses 172.31.0.10.
# Direct clients are never allowed to choose their identity with forwarded headers.
TRUSTED_PROXY_IPS=172.30.0.10/32
VITE_SKIP_AUTH=false
VITE_ENABLE_3D=false
# Tests only. Set exactly as documented before allowing destructive E2E cleanup.
E2E_DESTRUCTIVE_CLEANUP_CONFIRMATION=
